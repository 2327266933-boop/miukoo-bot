[Unit]
Description=BML Price Lose Feishu Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bml-price-lose-bot
EnvironmentFile=/opt/bml-price-lose-bot/.env
ExecStart=/opt/bml-price-lose-bot/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

